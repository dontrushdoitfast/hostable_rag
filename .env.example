# General Service Settings
APP_NAME="R2R SharePoint Retrieval Service"
API_KEY="default-secret-api-key"
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Connector Configuration
# Options: "dummy" or "sharepoint"
CONNECTOR_MODE="dummy"
LOCAL_DATA_DIR="./data/sharepoint_mock"
MOCK_SHAREPOINT_BASE_URL="https://contoso.sharepoint.com/sites/KnowledgeBase"

# SharePoint Integration Settings (Required if CONNECTOR_MODE="sharepoint")
SHAREPOINT_TENANT_ID=""
SHAREPOINT_CLIENT_ID=""
SHAREPOINT_CLIENT_SECRET=""
SHAREPOINT_SITE_ID=""

# Sync Configuration
SYNC_INTERVAL_SECONDS=3600
AUTO_SYNC_ENABLED=true

# R2R Engine Configuration
R2R_BASE_URL="http://localhost:7272"
R2R_API_KEY=""

# Azure OpenAI Embedding Configuration
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"
AZURE_OPENAI_API_VERSION="2023-05-15"
